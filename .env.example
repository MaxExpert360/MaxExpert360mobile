# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SQUARE BOOKINGS API & OAUTH CONFIGURATION
# SQUARE_APPLICATION_ID: Your Square Application ID (starts with sq0idp-...)
SQUARE_APPLICATION_ID=
# SQUARE_APPLICATION_SECRET: Your Square Application OAuth Secret (keep strictly confidential)
SQUARE_APPLICATION_SECRET=
# SQUARE_ACCESS_TOKEN: Your Square Access Token from Square Developer Dashboard (Developer -> Credentials -> Production/Sandbox Access Token)
SQUARE_ACCESS_TOKEN=

# SQUARE_ENVIRONMENT: "production" (default) or "sandbox"
SQUARE_ENVIRONMENT=production

# SQUARE_LOCATION_ID: Your Square Location ID (optional: if omitted, server queries and uses your active default Square location)
SQUARE_LOCATION_ID=

# GOOGLE MAPS PLATFORM API CONFIGURATION
# GOOGLE_MAPS_API_KEY: Your Google Cloud / Maps API Key with Places API (New), Geocoding API, and Maps JavaScript API enabled
GOOGLE_MAPS_API_KEY=

# TWILIO VERIFY API CONFIGURATION
# TWILIO_ACCOUNT_SID: Your Twilio Account SID (starts with AC...)
TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN: Your Twilio Auth Token
TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID: Your Twilio Verify Service SID (starts with VA...)
TWILIO_VERIFY_SERVICE_SID=

# FRONTEND API BASE URL (for building static frontend on GitHub Pages)
# When frontend is on maxexpert360.ca and backend is on Cloud Run, set this during build:
# VITE_API_BASE_URL=https://your-cloud-run-service-url.a.run.app
VITE_API_BASE_URL=

# BACKEND CORS SETTINGS (Optional extra origins on Cloud Run)
ALLOWED_ORIGINS=

# GOOGLE CLOUD STORAGE (Persistent Private Bucket on Cloud Run)
# GCS_BUCKET_NAME: Private GCS bucket name to store client booking photos persistently across deployments
GCS_BUCKET_NAME=maxexpert360-booking-photos
# GCS_REGION: GCP Region for the storage bucket (e.g. northamerica-northeast1 for Montreal/Quebec)
GCS_REGION=northamerica-northeast1

# GALLERY & TWILIO OWNER NOTIFICATION SECURITY
# GALLERY_SECRET_KEY: Secret key used to generate tamper-proof HMAC tokens for owner photo gallery access
GALLERY_SECRET_KEY=
# OWNER_PHONE_NUMBER: Owner mobile phone to receive SMS with secure private gallery links (e.g. +18736575102 or +18192548242)
OWNER_PHONE_NUMBER=+18736575102



